{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "skipLibCheck": true,
    "lib": ["esnext"],
    "types": ["node"]
  },
  "exclude": [
    "node_modules",
    "data",
    "tmp",
    "js",
    "public",
    "prototypes/*/**/*",
    "tests/unit/reaction-glyphs.test.js",
    "tests/unit/monogram.test.js",
    "tests/unit/note-flower.test.js",
    "tests/unit/admin-routes.test.js",
    "tests/unit/emoji.test.js",
    "tests/unit/guest-match.test.js",
    "tests/unit/split-resize.test.js",
    "tests/unit/gallery-paging.test.js",
    "tests/unit/curated-order.test.js",
    "tests/unit/chip-variant.test.js",
    "tests/unit/dresscode-descriptor.test.js",
    "tests/unit/effect-themes.test.js",
    "tests/unit/vision-align.test.js",
    "tests/unit/vision-detect.test.js",
    "tests/unit/vision-frame-hash.test.js",
    "tests/unit/vision-gate.test.js",
    "tests/unit/vision-group.test.js",
    "tests/unit/vision-metrics.test.js",
    "tests/unit/vision-purity.test.js",
    "tests/unit/vision-assign.test.js",
    "tests/unit/vision-confidence.test.js",
    "tests/unit/effect-config-schema.test.js",
    "tests/unit/thank-you-card.test.js",
    "tests/unit/thank-you-compose.test.js",
    "tests/unit/effect-config-merge.test.js",
    "tests/unit/frame-glint.test.js",
    "tests/unit/thank-you-presets.test.js",
    "tests/unit/effect-placement.test.js"
  ]
}
