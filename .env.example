# Server
PORT=3000
BASE_URL=http://localhost:3000
# Set to "production" to enable HSTS and reverse-proxy warnings
NODE_ENV=
# Timeline mode override: "pre" or "post" forces the landing copy + nav variant
# regardless of the wedding date. Leave empty to derive from the date (content.js).
SITE_MODE=
# Override the SQLite database path (scripts/tests use this; default data/wedding.db)
DATABASE_PATH=
# Override the audit-log directory (default data/audit)
AUDIT_LOG_DIR=
# CSP: set to "true" for per-request nonce mode; otherwise static-hash (cacheable)
CSP_NONCE=

# Admin (hash generated on first run - leave empty initially)
ADMIN_PASSWORD_HASH=

# Reply-to / contact address surfaced to guests
CONTACT_EMAIL=

# Reverse proxy: comma-separated trusted proxy IPs (for correct client IP behind Traefik).
# RFC-1918 private ranges are trusted by default; set this only to trust extra public IPs.
TRUSTED_PROXIES=
# How many hops back in X-Forwarded-For to read as the client IP (default 1)
TRUSTED_PROXY_DEPTH=

# Twilio (for SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Testing
TEST_ADMIN_PASSWORD=

# Resend (for email)
RESEND_API_KEY=
FROM_EMAIL=

# Media storage disk-guard thresholds (bytes). Defaults shown; override per deploy.
# Uploads pause when free disk drops below MIN_FREE or total originals exceed MAX_TOTAL.
MEDIA_MIN_FREE_BYTES=5368709120        # 5GB free-disk headroom
MEDIA_MAX_TOTAL_BYTES=48318382080      # 45GB cap on stored originals
MEDIA_UNTRUSTED_QUOTA_BYTES=262144000  # 250MB per untrusted account
# Days a rejected item's files sit in quarantine/ (mis-click recovery) before the
# daily sweep deletes them and frees the quota they were counting against.
MEDIA_QUARANTINE_TTL_DAYS=7
