# Environment variables (contains secrets)
.env

# Runtime data volume (SQLite DB, guest uploads, audit logs) — never committed.
# All persistent data lives here (the wedding-data Docker volume); it is
# machine-local runtime state, and uploads carry guests' EXIF/GPS + audit logs
# carry IPs, so the whole tree stays out of git.
data/

# Scratch space for exploratory work (never part of the app). Also where any
# throwaway tooling lives — a stock inference runtime used as a build-time oracle,
# derived face crops and descriptors — none of which may be imported by the repo.
tmp/

# Trained model weights: fetched and hash-verified by scripts/vision/fetch-weights.js,
# never committed. This repository is public, and committing weights would make us
# their distributor — a different permission from using them, and the one place
# "it's non-commercial" stops being a sufficient answer. Listed before the
# directory exists so it cannot be added by accident.
# See docs/post-wedding/VISION-MODELS.md.
public/vision/weights/

# Node
node_modules/

# Lockfiles
# package-lock.json is intentionally tracked so CI's `npm ci` (deploy.yml) works
# and the two devDependencies (typescript, @types/node) pin reproducibly.
yarn.lock
pnpm-lock.yaml

# OS
.DS_Store

# Claude
CLAUDE.md
.claude

# devloop's exported issue archive — the durable record kept after captured
# screenshots are pruned. This repository is public, and those records carry
# page DOM snippets, console output, and cropped screenshots of authed views.
.devloop/
