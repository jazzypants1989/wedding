# Environment variables (contains secrets)
.env

# Runtime data volume (SQLite DB, guest uploads, audit logs) — never committed.
# All persistent data lives here (the wedding-data Docker volume); it is
# machine-local runtime state, and uploads carry guests' EXIF/GPS + audit logs
# carry IPs, so the whole tree stays out of git.
data/

# Node
node_modules/

# Lockfiles
package-lock.json
yarn.lock
pnpm-lock.yaml

# OS
.DS_Store

# Claude
CLAUDE.md
.claude

