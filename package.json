{
  "name": "jesse-and-jordanas-wedding",
  "type": "module",
  "version": "1.0.0",
  "description": "Wedding RSVP system with zero npm dependencies",
  "main": "server.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --import=./tests/test-env.js --test tests/unit/*.test.js tests/unit/*/*.test.js tests/integration/*.test.js",
    "test:unit": "node --import=./tests/test-env.js --test tests/unit/*.test.js tests/unit/*/*.test.js",
    "test:integration": "node --import=./tests/test-env.js --test tests/integration/*.test.js",
    "typecheck": "tsc; s=$?; tsc -p public/tsconfig.json; c=$?; exit $((s||c))",
    "typecheck:server": "tsc",
    "typecheck:client": "tsc -p public/tsconfig.json",
    "dev": "node --watch-path=server.js --watch-path=types.js --watch-path=core --watch-path=api --watch-path=db --watch-path=services --watch-path=public server.js",
    "doctor": "node scripts/doctor.js",
    "setup": "node scripts/setup-admin.js",
    "seed": "node scripts/seed-preview.js",
    "seed:demo": "node scripts/seed-demo.js",
    "export": "node scripts/export-archive.js",
    "deploy": "node scripts/deploy.js"
  },
  "keywords": [
    "wedding",
    "rsvp"
  ],
  "author": "Jesse Pence",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "typescript": "^5.9.3"
  }
}
